# PostgreSQL
# Docker publishes 127.0.0.1:5433; Windows PostgreSQL may own localhost:5432.
# Process environment variables override this file; startup logs show the source.
DATABASE_URL=postgresql+asyncpg://archpilot:archpilot@127.0.0.1:5433/archpilot

# Generic OpenAI-compatible local server (e.g. llama.cpp)
LLM_PROVIDER=openai_compatible
LLM_MODEL=bonsai2-27b
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local
LLM_TEMPERATURE=0.15
# Per model call: long local generations may exceed the client's 10-minute default.
LLM_TIMEOUT_SECONDS=1800
# llama.cpp only: allow thinking to finish before the final JSON response.
LLM_REASONING_BUDGET_TOKENS=4096
# Classification, research planning and evaluation start lean; retries use the full budget.
LLM_PLANNING_REASONING_BUDGET_TOKENS=1024
# The critic uses a simpler complete audit map; design and all retries retain 4096.
LLM_REVIEW_REASONING_BUDGET_TOKENS=2048
# llama.cpp request option; does not modify the chat template.
LLM_REASONING_BUDGET_MESSAGE="Stop reasoning now. Output only a complete JSON object matching the supplied JSON Schema. Do not continue this analysis in the final response."

# Alternative: Ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=bonsai2-27b
# LLM_BASE_URL=http://localhost:11434/v1

SEARXNG_URL=http://localhost:8081
SEARCH_RESULTS_PER_QUERY=5
MAX_SEARCH_QUERIES=6
SEARCH_TIMEOUT_SECONDS=15

CORS_ORIGINS=http://localhost:3000
