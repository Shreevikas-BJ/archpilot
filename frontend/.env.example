# The FastAPI backend must be reachable from Vercel in production.
# For local development this can stay on localhost.
BACKEND_API_URL=http://127.0.0.1:8000
# Optional server-only secret used when FastAPI is exposed through a tunnel.
# Set the same value in the backend and Vercel. Never prefix it with NEXT_PUBLIC_.
ARCHPILOT_PROXY_TOKEN=
# Total wait for the multi-agent pipeline, including local Bonsai generation.
BACKEND_TIMEOUT_SECONDS=3600
