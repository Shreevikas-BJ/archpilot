# Copy to .env.self-hosted. Keep that file secret and outside source control.
DEPLOYMENT_MODE=self_hosted
DEPLOYMENT_LABEL=Private compute
LLM_DISPLAY_NAME=Bonsai 2 27B

# Any PostgreSQL-compatible managed or self-hosted service works. URL-encode credentials.
# AWS example: postgresql+asyncpg://user:password@cluster.region.rds.amazonaws.com:5432/archpilot?ssl=require
DATABASE_URL=postgresql+asyncpg://archpilot:replace-me@database.internal:5432/archpilot

# Any OpenAI-compatible endpoint works: llama.cpp, Ollama, vLLM, LiteLLM, or a gateway.
LLM_PROVIDER=openai_compatible
LLM_MODEL=bonsai2-27b
LLM_BASE_URL=http://model.internal:8080/v1
LLM_API_KEY=replace-me
LLM_TEMPERATURE=0.15
LLM_TIMEOUT_SECONDS=1800
LLM_REASONING_BUDGET_TOKENS=4096
LLM_PLANNING_REASONING_BUDGET_TOKENS=1024
LLM_REVIEW_REASONING_BUDGET_TOKENS=2048

# Run SearXNG locally, in the same VPC, or behind a private service endpoint.
SEARXNG_URL=http://search.internal:8080
SEARCH_RESULTS_PER_QUERY=5
MAX_SEARCH_QUERIES=6
SEARCH_TIMEOUT_SECONDS=15

ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000
# Generate a long random value. It stays server-side in both containers.
ARCHPILOT_PROXY_TOKEN=replace-with-a-random-secret
BACKEND_TIMEOUT_SECONDS=3600

FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Optional prebuilt images from ECR, GHCR, Docker Hub, or a private registry.
ARCHPILOT_BACKEND_IMAGE=archpilot-backend:local
ARCHPILOT_FRONTEND_IMAGE=archpilot-frontend:local
